generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Prestamo {
  id              Int       @id @default(autoincrement())
  usuarioId       Int
  libroId         Int
  fechaPrestamo   DateTime  @default(now())
  fechaDevolucion DateTime?
  estado          String    @default("PRESTADO")
}